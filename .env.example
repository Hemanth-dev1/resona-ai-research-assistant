# ── AI Research Agent — Environment Configuration ──────────────────────────
# Copy this file to .env and fill in your keys.
# The pipeline uses Groq by default; Gemini serves as an automatic fallback
# when Groq's daily token budget is near exhaustion.
#
#   cp .env.example .env
#   nano .env
#
# ── Required ───────────────────────────────────────────────────────────────

# Groq (primary provider — fastest, default)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# ── Recommended ────────────────────────────────────────────────────────────

# Google Gemini (automatic cross-provider fallback when Groq budget exhausted)
# Get a free API key at https://aistudio.google.com/apikey
# Gemini 3.5 Flash has ~1M TPM free tier with 1500 requests/day
# When this is set AND Groq's combined daily usage exceeds 90% of its budget,
# the pipeline automatically routes new calls to Gemini instead of hard-failing.
GOOGLE_API_KEY=AIza_your_key_here

# ── Optional (alternative providers) ───────────────────────────────────────

# OpenAI (set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=sk-your-key

# Anthropic (set LLM_PROVIDER=anthropic to use)
# ANTHROPIC_API_KEY=sk-ant-your-key

# Tavily (primary web search — much more reliable than ddgs fallback)
# Get a free API key at https://tavily.com
# TAVILY_API_KEY=tvly-your-key-here

# ── Pipeline tuning (all optional) ─────────────────────────────────────────

# LLM_PROVIDER=groq           # Default: groq. Options: groq, openai, anthropic
# LLM_MODEL=                  # Override default model name
# LLM_MODEL_FAST=             # Override fast/cheap model (planner, research)
# LLM_MODEL_CAPABLE=          # Override capable model (analyst, writer, critic)
# QUALITY_THRESHOLD=7         # Min critique score (0-10). Default: 7
# TOKEN_SOFT_GUARD_PCT=0.9    # Fraction of daily budget before fallback. Default: 0.9
# RESEARCH_MAX_CONCURRENT=1   # Parallel research workers. Default: 1 (avoid rate limits)
